<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Qolome_Devtoy_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Qolome_Devtoy_App"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DevtoyTableBorderBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="DevtoyTableGridLineBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowEvenBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowOddBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowPointerOverBrush" Color="#180078D7" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedBrush" Color="#330078D7" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedPointerOverBrush" Color="#440078D7" />
                    <SolidColorBrush x:Key="DevtoyTableRowForegroundBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedForegroundBrush" Color="#E4000000" />
                    <!-- 冻结表头须不透明，否则滚动时下层文字会透出 -->
                    <SolidColorBrush x:Key="DevtoyTableHeaderBackgroundBrush" Color="#FFF3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DevtoyTableBorderBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="DevtoyTableGridLineBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowEvenBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowOddBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowPointerOverBrush" Color="#180078D7" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedBrush" Color="#330078D7" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedPointerOverBrush" Color="#440078D7" />
                    <SolidColorBrush x:Key="DevtoyTableRowForegroundBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedForegroundBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="DevtoyTableHeaderBackgroundBrush" Color="#FFF3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DevtoyTableBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="DevtoyTableGridLineBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="DevtoyTableRowEvenBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="DevtoyTableRowOddBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="DevtoyTableRowPointerOverBrush" Color="#2860CDFF" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedBrush" Color="#4060CDFF" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedPointerOverBrush" Color="#5060CDFF" />
                    <SolidColorBrush x:Key="DevtoyTableRowForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DevtoyTableRowSelectedForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DevtoyTableHeaderBackgroundBrush" Color="#FF2B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
            <!-- Fluent UI System Icons（侧栏/按钮可用 FontIcon + Glyph） -->
            <FontFamily x:Key="FluentSystemIconsRegular">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
            <FontFamily x:Key="FluentSystemIconsFilled">ms-appx:///Assets/Fonts/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>
            <x:Double x:Key="DevtoyGlyphFontSize">14</x:Double>
            <!-- Fluent System Icons 视觉偏小，侧栏单独加大 -->
            <x:Double x:Key="DevtoyFluentIconFontSize">18</x:Double>
            <x:Double x:Key="DevtoyGlyphIconBox">14</x:Double>
            <Style x:Key="DevtoyGlyphTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource DevtoyGlyphFontSize}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- SymbolIcon 勿设 Width/Height（会裁切字形）；缩放由 Viewbox / ScaleTransform 处理 -->
            <Style x:Key="DevtoyGlyphIconStyle" TargetType="SymbolIcon">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="SymbolIcon" BasedOn="{StaticResource DevtoyGlyphIconStyle}" />
            <Style x:Key="SortHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,6" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
            <!-- 列表操作列：紧凑按钮，与行内文字视觉高度接近 -->
            <Style x:Key="DevtoyRowActionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{StaticResource DevtoyGlyphFontSize}" />
            </Style>
            <!-- 危险操作（删除）主按钮 -->
            <Style x:Key="DevtoyDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- 表格 / 列表：边框、行线、奇偶行、选中与当前行（勿 BasedOn DefaultListView*，WinUI 未导出这些 key） -->
            <Style x:Key="DevtoyTableListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource DevtoyTableGridLineBrush}" />
                <Setter Property="Background" Value="{ThemeResource DevtoyTableRowEvenBrush}" />
            </Style>

            <Style x:Key="DevtoyTableListViewStyle" TargetType="ListView">
                <Setter Property="BorderBrush" Value="{ThemeResource DevtoyTableBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource DevtoyTableListViewItemStyle}" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="helpers:TableListChrome.Enable" Value="True" />
            </Style>

            <Style x:Key="DevtoyTableHeaderStyle" TargetType="Grid">
                <!-- 水平 Padding 须与 DevtoyTableListViewItemStyle 一致，避免表头/表体错位 -->
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Background" Value="{ThemeResource DevtoyTableHeaderBackgroundBrush}" />
                <Setter Property="helpers:TableListChrome.ColumnLines" Value="True" />
            </Style>

            <!-- 表头：列宽够则单行，不够再按词换行；表体默认单行省略 -->
            <x:Double x:Key="DevtoyTableColumnMaxWidth">112</x:Double>
            <!-- 与 TableColumnMetrics 保持一致：复选框 / 序号 / 操作 / 日期时间 -->
            <x:Double x:Key="DevtoyTableCheckColumnWidth">30</x:Double>
            <x:Double x:Key="DevtoyTableIndexColumnWidth">44.72</x:Double>
            <x:Double x:Key="DevtoyTableActionColumnMaxWidth">356</x:Double>
            <x:Double x:Key="DevtoyTableDateTimeColumnWidth">128.4</x:Double>
            <x:Double x:Key="DevtoyTableDateTimeColumnMinWidth">84</x:Double>
            <Style x:Key="DevtoyTableHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DevtoyTableCellTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- 日期时间：够宽单行；挤窄时在空格处换成「日期一行 / 时间一行」 -->
            <Style x:Key="DevtoyTableDateTimeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DevtoyTableCellTextStyle}">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
