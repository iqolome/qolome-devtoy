<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ConsoleRow" Height="160" MinHeight="100" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="开发工具"
                    IsExpanded="True"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC7A;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Java代码生成" Tag="Generate">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource FluentSystemIconsRegular}"
                                    Glyph="&#xF0177;"
                                    FontSize="{StaticResource DevtoyFluentIconFontSize}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="字典管理" Tag="Dict">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Library" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="项目管理" Tag="Module">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Folder" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="网络工具"
                    IsExpanded="True"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="扫描" Tag="NetsScan">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE88A;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="设备列表" Tag="NetsDevices">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70C;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="网络拓扑" Tag="NetsTopology">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE968;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="网络环境" Tag="NetsEnvironments">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE909;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="设备类型" Tag="NetsDeviceTypes">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA6C;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="网络设置" Tag="NetsSettings">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="配置管理"
                    IsExpanded="True"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="主题设置" Tag="ConfigTheme">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource FluentSystemIconsRegular}"
                                    Glyph="&#xF2F6;"
                                    FontSize="{StaticResource DevtoyFluentIconFontSize}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="代码生成配置" Tag="ConfigBasic">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource FluentSystemIconsRegular}"
                                    Glyph="&#xF2F0;"
                                    FontSize="{StaticResource DevtoyFluentIconFontSize}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="数据源设置" Tag="ConfigDataSource">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource FluentSystemIconsRegular}"
                                    Glyph="&#xE467;"
                                    FontSize="{StaticResource DevtoyFluentIconFontSize}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="模板管理" Tag="ConfigTemplates">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource FluentSystemIconsRegular}"
                                    Glyph="&#xF124;"
                                    FontSize="{StaticResource DevtoyFluentIconFontSize}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="导入导出" Tag="ConfigImportExport">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource FluentSystemIconsRegular}"
                                    Glyph="&#xF03D3;"
                                    FontSize="{StaticResource DevtoyFluentIconFontSize}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE82F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="图标库" Tag="IconLibrary">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <!-- 遮罩仅盖住内容区，侧栏与控制台不受影响 -->
                <Grid>
                    <Frame
                        x:Name="ContentFrame"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent" />
                    <Grid
                        x:Name="BusyOverlay"
                        Visibility="Collapsed"
                        Background="#66000000"
                        Canvas.ZIndex="100">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Padding="24">
                            <ProgressRing
                                Width="40"
                                Height="40"
                                IsActive="True"
                                IsIndeterminate="True" />
                            <TextBlock
                                x:Name="BusyMessage"
                                Text="处理中…"
                                FontSize="14"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Grid
            x:Name="ConsolePanel"
            Grid.Row="1"
            Padding="12,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ConsoleBodyRow" Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Height="1"
                Margin="-12,0,-12,8"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button
                x:Name="ConsoleVisibilityButton"
                Grid.Row="1"
                Padding="8,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="OnConsoleVisibilityClick"
                ToolTipService.ToolTip="显示控制台">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox
                        Width="{StaticResource DevtoyGlyphIconBox}"
                        Height="{StaticResource DevtoyGlyphIconBox}"
                        VerticalAlignment="Center">
                        <SymbolIcon x:Name="ConsoleVisibilityIcon" Symbol="HideBcc" />
                    </Viewbox>
                    <TextBlock
                        Text="控制台"
                        Style="{StaticResource DevtoyGlyphTextStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Grid x:Name="ConsoleBody" Grid.Row="2" Margin="0,8,0,0">
                <TextBox
                    x:Name="ConsoleBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="清空" Click="OnClearConsole" />
                        </MenuFlyout>
                    </TextBox.ContextFlyout>
                </TextBox>
            </Grid>
        </Grid>
    </Grid>
</Page>
