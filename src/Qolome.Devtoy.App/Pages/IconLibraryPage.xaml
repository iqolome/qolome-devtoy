<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.IconLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="图标库"
            FontSize="24"
            FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="搜索名称 / Unicode / Symbol（如 Import）"
                TextChanged="OnSearchChanged" />
            <ComboBox
                x:Name="ScopeCombo"
                Grid.Column="1"
                MinWidth="160"
                VerticalAlignment="Center"
                SelectionChanged="OnScopeChanged">
                <ComboBoxItem Content="全部字形" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="仅 Symbol 枚举" Tag="symbol" />
            </ComboBox>
            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Opacity="0.75" />
            <TextBlock
                x:Name="CopiedHint"
                Grid.Column="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Opacity="0.85"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <GridView
            x:Name="IconGrid"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnIconClick"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="136"
                        Padding="10,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ToolTipService.ToolTip="{Binding Tooltip}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="{Binding Glyph}"
                                    FontSize="28"
                                    HorizontalAlignment="Center" />
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="4,1"
                                    CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding HasSymbol, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Text="Symbol"
                                        FontSize="9"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="11"
                                TextTrimming="CharacterEllipsis"
                                TextAlignment="Center"
                                HorizontalAlignment="Stretch" />
                            <TextBlock
                                Text="{Binding Unicode}"
                                FontSize="10"
                                Opacity="0.7"
                                TextAlignment="Center" />
                            <TextBlock
                                Text="{Binding SymbolName}"
                                FontSize="10"
                                Opacity="0.85"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasSymbol, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
