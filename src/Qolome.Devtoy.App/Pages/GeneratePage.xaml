<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="输出项目" VerticalAlignment="Center" FontWeight="SemiBold" />
            <AutoSuggestBox
                x:Name="ModuleSuggest"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                PlaceholderText="搜索输出项目"
                TextMemberPath="TargetModuleDisplay"
                UpdateTextOnSelect="True"
                TextChanged="OnModuleSuggestTextChanged"
                SuggestionChosen="OnModuleSuggestionChosen"
                QuerySubmitted="OnModuleQuerySubmitted"
                GotFocus="OnModuleSuggestGotFocus">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TargetModuleDisplay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模块名" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox
                x:Name="ModelNameBox"
                Grid.Column="1"
                PlaceholderText="对应 Java ModelName / package 模块段"
                VerticalAlignment="Center" />
            <Button Grid.Column="2" Click="OnSaveHabit" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="{StaticResource DevtoyGlyphIconBox}" Height="{StaticResource DevtoyGlyphIconBox}" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Save" />
                    </Viewbox>
                    <TextBlock Text="保存习惯" Style="{StaticResource DevtoyGlyphTextStyle}" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <CheckBox x:Name="TaskDao" Content="Dao（Entity / Mapper / XML）" IsChecked="True" />
            <CheckBox x:Name="TaskService" Content="Service" />
            <CheckBox x:Name="TaskController" Content="Controller" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="TableSearchBox"
                PlaceholderText="表名"
                VerticalAlignment="Center"
                KeyDown="OnTableSearchKeyDown" />
            <Button Grid.Column="1" Click="OnLoadTables" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="{StaticResource DevtoyGlyphIconBox}" Height="{StaticResource DevtoyGlyphIconBox}" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Find" />
                    </Viewbox>
                    <TextBlock Text="查询" Style="{StaticResource DevtoyGlyphTextStyle}" />
                </StackPanel>
            </Button>
        </Grid>
        <ListView
                Grid.Row="4"
                x:Name="TableList"
                SelectionMode="None"
                Style="{StaticResource DevtoyTableListViewStyle}"
                helpers:TableListChrome.ColumnLines="True">
                <ListView.Header>
                    <Grid
                        Padding="12,8"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource DevtoyTableGridLineBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid
                            x:Name="TableHeaderGrid"
                            ColumnSpacing="12"
                            HorizontalAlignment="Stretch"
                            helpers:TableListChrome.ColumnLines="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" MaxWidth="30" />
                                <ColumnDefinition Width="45" MaxWidth="45" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="1.4*" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="HeaderSelectAll"
                                MinWidth="0"
                                HorizontalAlignment="Center"
                                IsThreeState="True"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="全选 / 取消全选"
                                Checked="OnHeaderSelectAllChanged"
                                Unchecked="OnHeaderSelectAllChanged" />
                            <TextBlock Grid.Column="1" Text="序号" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="表名" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="表注释" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ListView.Header>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" MaxWidth="30" />
                                <ColumnDefinition Width="45" MaxWidth="45" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="1.4*" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                MinWidth="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Checked="OnRowCheckChanged"
                                Unchecked="OnRowCheckChanged" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Index}"
                                Opacity="0.75"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Name}"
                                FontFamily="Consolas"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding CommentDisplay}"
                                Opacity="0.7"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding CommentDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        <Button
            Grid.Row="5"
            x:Name="GenerateBtn"
            Click="OnGenerate"
            HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ProgressRing
                    x:Name="GenerateBusyRing"
                    Width="{StaticResource DevtoyGlyphIconBox}"
                    Height="{StaticResource DevtoyGlyphIconBox}"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Viewbox
                    x:Name="GenerateIcon"
                    Width="{StaticResource DevtoyGlyphIconBox}"
                    Height="{StaticResource DevtoyGlyphIconBox}"
                    VerticalAlignment="Center">
                    <SymbolIcon Symbol="Play" />
                </Viewbox>
                <TextBlock x:Name="GenerateBtnText" Text="生成" Style="{StaticResource DevtoyGlyphTextStyle}" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
