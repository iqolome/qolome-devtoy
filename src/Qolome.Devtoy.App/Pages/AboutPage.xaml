<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,20,32,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="关于" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border
                    Width="72"
                    Height="72"
                    CornerRadius="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <Image
                        x:Name="ProductLogo"
                        Stretch="Uniform"
                        Margin="4" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="ProductText" FontSize="20" />
                    <TextBlock x:Name="VersionText" Opacity="0.75" />
                </StackPanel>
            </StackPanel>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <TextBlock Text="开发商" FontWeight="SemiBold" />
            <TextBlock x:Name="CompanyZhText" TextWrapping="WrapWholeWords" />
            <TextBlock x:Name="CompanyEnText" Opacity="0.85" TextWrapping="WrapWholeWords" />
            <HyperlinkButton x:Name="WebsiteLink" Content="https://www.jfonda.com/" />
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <TextBlock Text="许可协议" FontWeight="SemiBold" />
            <TextBlock x:Name="LicenseText" TextWrapping="WrapWholeWords" />
            <HyperlinkButton x:Name="LicenseLink" Content="Apache License 2.0" />
        </StackPanel>
    </ScrollViewer>
</Page>