<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.DataSourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,20,32,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Text="数据源设置" FontSize="24" FontWeight="SemiBold" />
            <TextBlock
                TextWrapping="Wrap"
                Opacity="0.75"
                Text="本机 SQLite（%LocalAppData%\Qolome\Devtoy\qolome-devtoy.db）仅保存少量应用配置。此处配置的远程库为唯一业务库：网络库存、拓扑、OUI、字典与代码生成均使用该库（网络业务日常读写当前支持 MySQL）。" />
            <Grid x:Name="FormGrid" ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="输入方式" VerticalAlignment="Center" />
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16">
                    <RadioButton
                        x:Name="ModeUrlRadio"
                        Content="URL"
                        GroupName="JdbcInputMode"
                        Checked="OnInputModeRadioChecked" />
                    <RadioButton
                        x:Name="ModeFieldsRadio"
                        Content="输入"
                        GroupName="JdbcInputMode"
                        Checked="OnInputModeRadioChecked" />
                </StackPanel>

                <TextBlock
                    x:Name="JdbcLabel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="JDBC 连接"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <TextBox
                    x:Name="JdbcUrlBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    PlaceholderText="jdbc:mysql://127.0.0.1:3306/qolome"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="DbKindLabel"
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="数据库类型"
                    VerticalAlignment="Center" />
                <ComboBox x:Name="DbKindBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" />

                <TextBlock
                    x:Name="HostLabel"
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="主机"
                    VerticalAlignment="Center" />
                <TextBox x:Name="HostBox" Grid.Row="3" Grid.Column="1" />

                <TextBlock
                    x:Name="PortLabel"
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="端口"
                    VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Row="4" Grid.Column="1" />

                <TextBlock
                    x:Name="DatabaseLabel"
                    Grid.Row="5"
                    Grid.Column="0"
                    Text="数据库名称"
                    VerticalAlignment="Center" />
                <TextBox x:Name="DatabaseBox" Grid.Row="5" Grid.Column="1" />

                <TextBlock
                    x:Name="ParamsLabel"
                    Grid.Row="6"
                    Grid.Column="0"
                    Text="连接参数"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="MySQL 等 JDBC 参数；ODBC 时可填 Driver={...} 或完整连接串片段" />
                <TextBox
                    x:Name="ParamsBox"
                    Grid.Row="6"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="80"
                    PlaceholderText="useSSL=false&amp;… 或 ODBC: Driver={PostgreSQL Unicode}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="用户名" VerticalAlignment="Center" />
                <TextBox x:Name="UserBox" Grid.Row="7" Grid.Column="1" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="密码" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="8" Grid.Column="1" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="120,4,0,0">
                <Button Click="OnSave">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Save" />
                        </Viewbox>
                        <TextBlock Text="保存" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Click="OnTest">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Link" />
                        </Viewbox>
                        <TextBlock Text="测试连接" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Click="OnGenerateInitSql">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Document" />
                        </Viewbox>
                        <TextBlock Text="生成初始化SQL" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Click="OnInitializeSchema">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Play" />
                        </Viewbox>
                        <TextBlock Text="初始化" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>