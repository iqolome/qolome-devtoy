<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.ImportExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,20,32,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="导入导出" FontSize="24" FontWeight="SemiBold" />
            <Border
                Padding="16"
                CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="配置以本机全局 JSON 为准（与 qolome-codegen 对齐），包含作者、数据源、工作区、指定工程等完整内容。" TextWrapping="WrapWholeWords" Opacity="0.85" />
                    <TextBlock x:Name="ConfigPathText" Opacity="0.7" TextWrapping="WrapWholeWords" FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnExportConfig"
                            Style="{StaticResource DevtoyRowActionButtonStyle}"
                            Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox
                                    Width="{StaticResource DevtoyGlyphIconBox}"
                                    Height="{StaticResource DevtoyGlyphIconBox}"
                                    VerticalAlignment="Center">
                                    <SymbolIcon Symbol="SaveLocal" />
                                </Viewbox>
                                <TextBlock Text="导出配置" Style="{StaticResource DevtoyGlyphTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Click="OnImportConfig"
                            Style="{StaticResource DevtoyRowActionButtonStyle}"
                            Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox
                                    Width="{StaticResource DevtoyGlyphIconBox}"
                                    Height="{StaticResource DevtoyGlyphIconBox}"
                                    VerticalAlignment="Center">
                                    <SymbolIcon Symbol="OpenLocal" />
                                </Viewbox>
                                <TextBlock Text="导入配置" Style="{StaticResource DevtoyGlyphTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>