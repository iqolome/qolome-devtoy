<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.TemplatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tcb="using:TextControlBoxNS">
    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            Text="模板管理"
            FontSize="24"
            FontWeight="SemiBold" />
        <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="2"
            x:Name="PathHint"
            Opacity="0.75"
            TextWrapping="WrapWholeWords" />

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnReloadList">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Refresh" />
                        </Viewbox>
                        <TextBlock Text="刷新" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Click="OnResetAll">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Undo" />
                        </Viewbox>
                        <TextBlock Text="全部还原默认" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ListView
                Grid.Row="1"
                x:Name="TemplateList"
                SelectionMode="Single"
                SelectionChanged="OnTemplateSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="0,4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{Binding FileName}"
                                Opacity="0.7"
                                FontFamily="Consolas"
                                FontSize="12" />
                            <TextBlock Text="{Binding Category}" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="EditorTitle"
                Text="选择左侧模板进行编辑"
                FontWeight="SemiBold"
                TextWrapping="WrapWholeWords" />
            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <tcb:TextControlBox
                    x:Name="EditorBox"
                    FontFamily="Consolas"
                    FontSize="13"
                    IsEnabled="False"
                    ShowLineNumbers="True"
                    ShowLineHighlighter="True"
                    EnableSyntaxHighlighting="True"
                    CornerRadius="4" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveBtn" Click="OnSave" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Save" />
                        </Viewbox>
                        <TextBlock Text="保存" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResetOneBtn" Click="OnResetOne" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Undo" />
                        </Viewbox>
                        <TextBlock Text="还原此模板" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
