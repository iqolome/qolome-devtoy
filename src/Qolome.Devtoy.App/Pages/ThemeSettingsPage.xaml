<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.ThemeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,20,32,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Text="主题设置" FontSize="24" FontWeight="SemiBold" />
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="界面主题" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="AppThemeCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    SelectionChanged="OnAppThemeChanged" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="图标主题" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="IconVariantCombo" MinWidth="200" SelectionChanged="OnIconVariantChanged" />
                    <Border
                        x:Name="IconPreviewHost"
                        Width="72"
                        Height="72"
                        CornerRadius="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" />
                </StackPanel>
            </Grid>
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="性能" FontWeight="SemiBold" />
                </Expander.Header>
                <StackPanel Margin="0,8,0,0" Spacing="12">
                    <ToggleSwitch
                        x:Name="HardwareAccelSwitch"
                        Header="硬件加速（GPU 合成）"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnHardwareAccelToggled" />
                    <TextBlock
                        Text="开启时优先 Composition/GPU 合成；关闭会降级表格附加可视层以减轻驱动压力（WinUI 无法完全退回纯软件渲染）。"
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <ToggleSwitch
                        x:Name="ParallelCollectorsSwitch"
                        Header="多核并行采集"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnParallelCollectorsToggled" />
                    <TextBlock
                        Text="本机信息等采集任务并行读取 WMI/netsh，充分利用多核。"
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <ToggleSwitch
                        x:Name="RichTableSwitch"
                        Header="表格富视觉（奇偶行 / 列分割线）"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnRichTableToggled" />
                    <TextBlock
                        Text="关闭可减少列表可视元素数量；硬件加速关闭时自动降级。"
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Expander>

            <Button Click="OnSave" Margin="0,4,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="{StaticResource DevtoyGlyphIconBox}" Height="{StaticResource DevtoyGlyphIconBox}" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Save" />
                    </Viewbox>
                    <TextBlock Text="保存" Style="{StaticResource DevtoyGlyphTextStyle}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
