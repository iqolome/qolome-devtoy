<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome_Devtoy_App.Pages.ThemeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,20,32,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Text="主题设置" FontSize="24" FontWeight="SemiBold" />
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="界面主题" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="AppThemeCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    SelectionChanged="OnAppThemeChanged" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="图标主题" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="IconVariantCombo" MinWidth="200" SelectionChanged="OnIconVariantChanged" />
                    <Border
                        x:Name="IconPreviewHost"
                        Width="72"
                        Height="72"
                        CornerRadius="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" />
                </StackPanel>
            </Grid>
            <Button Click="OnSave" Margin="120,4,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="{StaticResource DevtoyGlyphIconBox}" Height="{StaticResource DevtoyGlyphIconBox}" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Save" />
                    </Viewbox>
                    <TextBlock Text="保存" Style="{StaticResource DevtoyGlyphTextStyle}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
