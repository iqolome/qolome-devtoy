<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Title="使用说明"
            IsOpen="True"
            IsClosable="True"
            Severity="Informational"
            Message="仅扫描你有权管理的网络。MAC 仅在同一二层网段可用；ICMP 被禁时可能仍能通过 TCP 发现主机，但不会记为 Ping 成功。" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="网卡 / 子网" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Grid.Column="1" Text="扫描目标（CIDR / IP 段 / 单 IP）" Style="{StaticResource CaptionTextBlockStyle}" />

            <ComboBox
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                ItemsSource="{x:Bind ViewModel.Adapters}"
                DisplayMemberPath="DisplayName"
                SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Top"
                Text="{x:Bind ViewModel.TargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="192.168.1.0/24 或 10.0.0.1-50" />
            <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Spacing="4">
                <TextBlock Text="TCP 端口（留空则不扫 TCP）" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox
                    Text="{x:Bind ViewModel.PortsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="22,80,443,8000-8100,9100-9200"
                    ToolTipService.ToolTip="单端口与区间可混用，逗号分隔。例如 22,80,8000-8100,9100-9200" />
                <TextBlock Text="UDP 端口（留空则不扫 UDP）" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox
                    Text="{x:Bind ViewModel.UdpPortsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="53,161,8000-8100,9100-9200"
                    ToolTipService.ToolTip="单端口与区间可混用，逗号分隔。例如 53,161,8000-8100,9100-9200" />
            </StackPanel>
            <Button
                Grid.Row="1"
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.StartScanCommand}"
                Content="开始扫描" />
            <Button
                Grid.Row="1"
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.StopScanCommand}"
                Content="停止" />

            <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <ComboBox
                    Header="网络环境"
                    MinWidth="160"
                    ItemsSource="{x:Bind ViewModel.Environments}"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}" />
                <ComboBox
                    Header="保存到分组"
                    MinWidth="140"
                    ItemsSource="{x:Bind ViewModel.Groups}"
                    DisplayMemberPath="Name"
                    PlaceholderText="不分组"
                    SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" />
                <Button
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ToggleSelectAllCommand}"
                    Content="全选" />
                <Button
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ClearCheckedCommand}"
                    Content="取消勾选" />
                <Button
                    VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveScanCommand}"
                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" />
                <Button
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ExportScanCommand}"
                    Content="导出 Excel" />
            </StackPanel>
        </Grid>

        <Expander Grid.Row="2" Header="高级选项" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox
                    Grid.Column="0"
                    Header="Ping 超时 (ms)"
                    Minimum="100"
                    Maximum="5000"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.PingTimeoutMs, Mode=TwoWay}" />
                <NumberBox
                    Grid.Column="1"
                    Header="端口超时 (ms)"
                    Minimum="50"
                    Maximum="5000"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.ConnectTimeoutMs, Mode=TwoWay}" />
                <NumberBox
                    Grid.Column="2"
                    Header="Ping 包大小"
                    Minimum="1"
                    Maximum="65500"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.PingPayloadSize, Mode=TwoWay}" />
                <ToggleSwitch
                    Grid.Column="3"
                    Header="UDP 超时"
                    OnContent="视为开放"
                    OffContent="忽略"
                    IsOn="{x:Bind ViewModel.TreatUdpTimeoutAsOpen, Mode=TwoWay}" />
            </Grid>
        </Expander>

        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Maximum="100" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                        ItemsSource="{x:Bind ViewModel.Hosts}"
                        SelectedItem="{x:Bind ViewModel.SelectedHost, Mode=TwoWay}"
                        SelectionMode="Single"
                        Style="{StaticResource DevtoyTableListViewStyle}"
                        BorderThickness="0"
                        helpers:TableListChrome.ColumnLines="True">
                        <ListView.Header>
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="8"
                                Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                                BorderBrush="{ThemeResource DevtoyTableGridLineBrush}"
                                BorderThickness="0,0,0,1"
                                helpers:TableListChrome.ColumnLines="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    Padding="0"
                                    IsChecked="{x:Bind ViewModel.IsAllChecked, Mode=TwoWay}"
                                    ToolTipService.ToolTip="全选 / 取消全选" />
                                <TextBlock Grid.Column="1" Text="IP" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="主机名" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="MAC" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="厂商" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="系统" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="延迟" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="TTL" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="开放端口" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="9" Text="状态" FontWeight="SemiBold" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                                <Setter Property="Padding" Value="12,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HostItemViewModel">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Ip, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Hostname, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Mac, Mode=OneWay}" FontFamily="Consolas" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Vendor, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind OsType, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Latency, Mode=OneWay}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind Ttl, Mode=OneWay}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind Ports, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="9" Text="{x:Bind Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border
                        Padding="14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="设备详情" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="IP：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Ip, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="主机名：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Hostname, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="MAC：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Mac, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="厂商：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Vendor, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="系统类型：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.OsType, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="设备信息：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.DeviceInfo, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="Ping：" />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Size, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                                <Run Text=" / " />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Latency, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                                <Run Text=" / TTL " />
                                <Run Text="{x:Bind ViewModel.SelectedHost.Ttl, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Text="开放端口" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <ListView
                                MaxHeight="220"
                                SelectionMode="Single"
                                Style="{StaticResource DevtoyTableListViewStyle}"
                                ItemsSource="{x:Bind ViewModel.SelectedHost.PortItems, Mode=OneWay, FallbackValue={x:Null}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OpenPortItemViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Display}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Grid.Column="1"
                                                Content="标记"
                                                Click="AnnotatePort_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedHost.PortDetails, Mode=OneWay, FallbackValue=选择左侧主机查看端口, TargetNullValue=选择左侧主机查看端口}"
                                TextWrapping="Wrap"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Ping" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    Header="次数"
                                    Minimum="1"
                                    Maximum="100"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.PingCount, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    Header="连续 Ping"
                                    OnContent="连续"
                                    OffContent="按次数"
                                    IsOn="{x:Bind ViewModel.PingContinuous, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.StartPingCommand}"
                                    Content="开始 Ping" />
                                <Button Command="{x:Bind ViewModel.StopPingCommand}" Content="停止" />
                            </StackPanel>
                            <ListView
                                Height="180"
                                Style="{StaticResource DevtoyTableListViewStyle}"
                                ItemsSource="{x:Bind ViewModel.PingLines}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PingLineViewModel">
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Text="{x:Bind ViewModel.PingSummaryText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
