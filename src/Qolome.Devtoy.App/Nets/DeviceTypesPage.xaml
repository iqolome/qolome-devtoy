<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.DeviceTypesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Qolome.Nets.Core.Data"
    xmlns:local="using:Qolome.Nets.App"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers">

    <Page.Resources>
        <CollectionViewSource x:Name="TypesCvs" IsSourceGrouped="True" />
        <local:HexBrushConverter x:Key="HexBrush" />
    </Page.Resources>

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设备类型" Style="{StaticResource SubtitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox
                MinWidth="220"
                PlaceholderText="搜索名称 / 编码 / 分组"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                MinWidth="180"
                VerticalAlignment="Center"
                PlaceholderText="颜色分组"
                ItemsSource="{x:Bind ViewModel.GroupFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedGroupFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceTypeColorFilter">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle
                                Width="12"
                                Height="12"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{x:Bind local:DeviceTypeColorXaml.FromHex(ColorHex)}"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Click="Add_Click" Content="新增" />
            <Button Click="Edit_Click" Content="编辑" />
            <Button Click="Delete_Click" Content="删除" />
            <Button Click="Template_Click" Content="下载模板" />
            <Button Click="Import_Click" Content="导入 Excel" />
            <Button Click="Export_Click" Content="导出 Excel" />
            <Button Click="ExportIcons_Click" Content="导出图标" />
        </StackPanel>
        <ListView
            x:Name="TypesList"
            Grid.Row="2"
            SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
            Style="{StaticResource DevtoyTableListViewStyle}"
            helpers:TableListChrome.ColumnLines="True">
            <ListView.Header>
                <Grid
                    Padding="12,8"
                    ColumnSpacing="12"
                    Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource DevtoyTableGridLineBrush}"
                    BorderThickness="0,0,0,1"
                    helpers:TableListChrome.ColumnLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图标" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="编码" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="名称" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="分组" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="说明" FontWeight="SemiBold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,8,4,4">
                                <Rectangle
                                    Width="12"
                                    Height="12"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Fill="{Binding Group.ColorHex, Converter={StaticResource HexBrush}}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding Group.Title}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:DeviceType">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="24"
                            Height="24"
                            Stretch="Uniform"
                            Source="{x:Bind local:DeviceTypeIconXaml.From(Code, IconFile, IsCustomIcon, ColorGroup), Mode=OneTime}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Code}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Rectangle
                                Width="12"
                                Height="12"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{x:Bind local:DeviceTypeColorXaml.BrushFromGroup(ColorGroup, Code)}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind data:DeviceTypeColorGroups.DisplayName(ColorGroup, Code)}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind Description}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
    </Grid>
</Page>
