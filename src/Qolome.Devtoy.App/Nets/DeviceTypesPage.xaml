<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.DeviceTypesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Qolome.Nets.Core.Data"
    xmlns:local="using:Qolome.Nets.App"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers">

    <Page.Resources>
        <CollectionViewSource x:Name="TypesCvs" IsSourceGrouped="True" />
        <local:HexBrushConverter x:Key="HexBrush" />
    </Page.Resources>

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设备类型" Style="{StaticResource SubtitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox
                MinWidth="220"
                PlaceholderText="搜索名称 / 编码 / 分组"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                MinWidth="180"
                VerticalAlignment="Center"
                PlaceholderText="颜色分组"
                ItemsSource="{x:Bind ViewModel.GroupFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedGroupFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceTypeColorFilter">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle
                                Width="12"
                                Height="12"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{x:Bind local:DeviceTypeColorXaml.FromHex(ColorHex)}"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Click="Add_Click" Content="新增" />
            <Button
                Click="Delete_Click"
                Content="删除"
                ToolTipService.ToolTip="删除选中设备类型。Ctrl 点选、Shift 连选可多选" />
            <Button Click="Template_Click" Content="下载模板" />
            <Button Click="Import_Click" Content="导入 Excel" />
            <Button Click="Export_Click" Content="导出 Excel" />
            <Button Click="ExportIcons_Click" Content="导出图标" />
        </StackPanel>
        <ListView
            x:Name="TypesList"
            Grid.Row="2"
            SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
            SelectionMode="Extended"
            SelectionChanged="Types_SelectionChanged"
            Style="{StaticResource DevtoyTableListViewStyle}"
            helpers:TableListChrome.ColumnLines="True">
            <ListView.Header>
                <Grid
                    Padding="12,8"
                    ColumnSpacing="12"
                    Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource DevtoyTableGridLineBrush}"
                    BorderThickness="0,0,0,1"
                    helpers:TableListChrome.ColumnLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" MaxWidth="30" />
                        <ColumnDefinition Width="45" MaxWidth="45" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="356" MaxWidth="356" MinWidth="140" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="HeaderSelectAll"
                        MinWidth="0"
                        HorizontalAlignment="Center"
                        IsThreeState="True"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="全选 / 取消全选"
                        Checked="OnSelectAllChanged"
                        Unchecked="OnSelectAllChanged" />
                    <TextBlock Grid.Column="1" Text="序号" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="图标" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="编码" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="名称" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="分组" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="说明" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="操作" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <!-- DataContext 即 DeviceTypeColorGroupView 本身，勿用 Group.xxx -->
                        <DataTemplate x:DataType="vm:DeviceTypeColorGroupView">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8">
                                <Rectangle
                                    Width="12"
                                    Height="12"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Fill="{x:Bind local:DeviceTypeColorXaml.FromHex(ColorHex)}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:DeviceType">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" MaxWidth="30" />
                            <ColumnDefinition Width="45" MaxWidth="45" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="356" MaxWidth="356" MinWidth="140" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            MinWidth="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Tag="{x:Bind}"
                            Loaded="OnRowCheckLoaded"
                            Checked="OnRowCheckChanged"
                            Unchecked="OnRowCheckChanged" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind RowIndex}"
                            Opacity="0.75"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Stretch="Uniform"
                            Source="{x:Bind local:DeviceTypeIconXaml.From(Code, IconFile, IsCustomIcon, ColorGroup), Mode=OneTime}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Code}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Name}" VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="5"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Rectangle
                                Width="12"
                                Height="12"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{x:Bind local:DeviceTypeColorXaml.BrushFromGroup(ColorGroup, Code)}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind data:DeviceTypeColorGroups.DisplayName(ColorGroup, Code)}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="6" Text="{x:Bind Description}" VerticalAlignment="Center" />
                        <helpers:ActionButtonWrapPanel Grid.Column="7" MaxWidth="356" VerticalAlignment="Center">
                            <Button
                                Tag="{x:Bind}"
                                Click="RowEdit_Click"
                                Style="{StaticResource DevtoyRowActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Viewbox
                                        Width="{StaticResource DevtoyGlyphIconBox}"
                                        Height="{StaticResource DevtoyGlyphIconBox}"
                                        VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Edit" />
                                    </Viewbox>
                                    <TextBlock Text="编辑" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Tag="{x:Bind}"
                                Click="RowDelete_Click"
                                Style="{StaticResource DevtoyRowActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Viewbox
                                        Width="{StaticResource DevtoyGlyphIconBox}"
                                        Height="{StaticResource DevtoyGlyphIconBox}"
                                        VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Delete" />
                                    </Viewbox>
                                    <TextBlock Text="删除" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                </StackPanel>
                            </Button>
                        </helpers:ActionButtonWrapPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
    </Grid>
</Page>