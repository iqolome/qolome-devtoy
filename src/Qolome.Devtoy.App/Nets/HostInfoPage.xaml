<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.HostInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            MaxHeight="440"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="本机信息" Style="{StaticResource TitleTextBlockStyle}" />

        <Border
            Grid.Row="1"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="硬件信息" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsHardwareBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsHardwareBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button
                        Grid.Column="2"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshHardwareCommand}"
                        ToolTipService.ToolTip="刷新硬件信息">
                        <Viewbox Width="{StaticResource DevtoyGlyphIconBox}" Height="{StaticResource DevtoyGlyphIconBox}">
                            <SymbolIcon Symbol="Refresh" />
                        </Viewbox>
                    </Button>
                </Grid>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="设备名称：" />
                    <Run Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="设备型号：" />
                    <Run Text="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="处理器：" />
                    <Run Text="{x:Bind ViewModel.ProcessorDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="内存：" />
                    <Run Text="{x:Bind ViewModel.MemoryDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="操作系统：" />
                    <Run Text="{x:Bind ViewModel.OsDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontWeight="SemiBold" Text="硬盘信息：" />
                <TextBlock
                    Text="{x:Bind ViewModel.DiskInfoDisplay, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock FontWeight="SemiBold" Text="显卡信息：" />
                <TextBlock
                    Text="{x:Bind ViewModel.GpuInfoDisplay, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="网络信息" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsNetworkBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsNetworkBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button
                        Grid.Column="2"
                        Padding="6"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshNetworkCommand}"
                        ToolTipService.ToolTip="刷新网络信息">
                        <Viewbox Width="{StaticResource DevtoyGlyphIconBox}" Height="{StaticResource DevtoyGlyphIconBox}">
                            <SymbolIcon Symbol="Refresh" />
                        </Viewbox>
                    </Button>
                </Grid>
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="IPv4 地址：" />
                        <Run Text="{x:Bind ViewModel.EgressIpv4, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="IPv6 地址：" />
                        <Run Text="{x:Bind ViewModel.EgressIpv6, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="自治域：" />
                        <Run Text="{x:Bind ViewModel.Asn, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="服务商：" />
                        <Run Text="{x:Bind ViewModel.Isp, Mode=OneWay}" />
                        <Run Text="　　" />
                        <Run FontWeight="SemiBold" Text="组织：" />
                        <Run Text="{x:Bind ViewModel.Organization, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="时区：" />
                        <Run Text="{x:Bind ViewModel.TimeZone, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="位置：" />
                        <Run Text="{x:Bind ViewModel.Location, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="网卡信息"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox
                Grid.Column="1"
                PlaceholderText="筛选名称 / MAC / IP…"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="2"
                MinWidth="120"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.KindFilterOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedKindFilter, Mode=TwoWay}"
                DisplayMemberPath="Label"
                ToolTipService.ToolTip="按网卡类型筛选：全部 / 物理 / 虚拟 / NDIS筛选器" />
            <StackPanel
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Content="启用"
                    Click="EnableAdapter_Click"
                    IsEnabled="{x:Bind ViewModel.CanEnableSelected, Mode=OneWay}"
                    ToolTipService.ToolTip="启用所选网卡（物理 / 软网卡；需管理员权限）" />
                <Button
                    Content="禁用"
                    Click="DisableAdapter_Click"
                    IsEnabled="{x:Bind ViewModel.CanDisableSelected, Mode=OneWay}"
                    ToolTipService.ToolTip="禁用所选网卡（物理 / 软网卡；需管理员权限）" />
                <Button
                    Content="删除"
                    Click="RemoveAdapter_Click"
                    IsEnabled="{x:Bind ViewModel.CanRemoveSelected, Mode=OneWay}"
                    ToolTipService.ToolTip="仅软网卡可删除（卸载设备；物理网卡不可用）" />
            </StackPanel>
        </Grid>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <!-- 外层横向滚动 + 统一列宽，避免 Auto 列导致表头/行错位 -->
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid x:Name="NicTableHost">
                    <ListView
                        x:Name="NicList"
                        ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                        SelectionMode="Single"
                        Style="{StaticResource DevtoyTableListViewStyle}"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        helpers:TableListChrome.ColumnLines="True">
                        <ListView.Header>
                            <Grid
                                x:Name="NicHeaderRow"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                                BorderBrush="{ThemeResource DevtoyTableGridLineBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid
                                    x:Name="NicHeaderGrid"
                                    ColumnSpacing="8"
                                    HorizontalAlignment="Stretch"
                                    helpers:TableListChrome.ColumnLines="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" MaxWidth="45" />
                                        <ColumnDefinition Width="120" MinWidth="96" />
                                        <ColumnDefinition Width="180" MinWidth="120" />
                                        <ColumnDefinition Width="64" MinWidth="48" />
                                        <ColumnDefinition Width="80" MinWidth="64" />
                                        <ColumnDefinition Width="88" MinWidth="64" />
                                        <ColumnDefinition Width="160" MinWidth="120" />
                                        <ColumnDefinition Width="160" MinWidth="120" />
                                        <ColumnDefinition Width="120" MinWidth="88" />
                                        <ColumnDefinition Width="140" MinWidth="100" />
                                        <ColumnDefinition Width="100" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="序号" Style="{StaticResource DevtoyTableHeaderTextStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="连接名" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="网卡名称" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="类型" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="连接方式" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="速率" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="6" Text="IPv4 信息" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="7" Text="IPv6 信息" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="8" Text="网关" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="9" Text="MAC" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="10" Text="持续时间" Style="{StaticResource DevtoyTableHeaderTextStyle}" />
                                </Grid>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocalNicRow">
                                <Grid
                                    ColumnSpacing="8"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="{x:Bind Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" MaxWidth="45" />
                                        <ColumnDefinition Width="120" MinWidth="96" />
                                        <ColumnDefinition Width="180" MinWidth="120" />
                                        <ColumnDefinition Width="64" MinWidth="48" />
                                        <ColumnDefinition Width="80" MinWidth="64" />
                                        <ColumnDefinition Width="88" MinWidth="64" />
                                        <ColumnDefinition Width="160" MinWidth="120" />
                                        <ColumnDefinition Width="160" MinWidth="120" />
                                        <ColumnDefinition Width="120" MinWidth="88" />
                                        <ColumnDefinition Width="140" MinWidth="100" />
                                        <ColumnDefinition Width="100" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Index}" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind NetworkName}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind AdapterName}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind KindLabel}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ConnectionDisplay}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind SpeedDisplay}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{x:Bind Ipv4Info}"
                                        Style="{StaticResource DevtoyTableCellTextStyle}"
                                        ToolTipService.ToolTip="{x:Bind Ipv4Info}" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Text="{x:Bind Ipv6Info}"
                                        Style="{StaticResource DevtoyTableCellTextStyle}"
                                        ToolTipService.ToolTip="{x:Bind Ipv6Info}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind Gateway}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock
                                        Grid.Column="9"
                                        Text="{x:Bind Mac}"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Style="{StaticResource DevtoyTableCellTextStyle}" />
                                    <TextBlock Grid.Column="10" Text="{x:Bind Duration}" Style="{StaticResource DevtoyTableCellTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Border>

        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.8" />

        <!-- 初次进入 / 刷新 / 网卡操作：整页 loading，防误操作 -->
        <Grid
            Grid.RowSpan="3"
            Canvas.ZIndex="100"
            Background="#88000000"
            Visibility="{x:Bind ViewModel.PageBusyVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Padding="24">
                <ProgressRing
                    Width="48"
                    Height="48"
                    IsActive="{x:Bind ViewModel.IsPageBusy, Mode=OneWay}"
                    IsIndeterminate="True" />
                <TextBlock
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    FontSize="14"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
