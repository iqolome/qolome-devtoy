<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.HostInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="16"
        HorizontalScrollMode="Auto"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled"
        VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="本机信息" Style="{StaticResource TitleTextBlockStyle}" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="刷新" />
            </Grid>

        <Border
            Grid.Row="1"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="硬件信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ProgressBar
                        x:Name="BusyBar"
                        Grid.Column="1"
                        Width="120"
                        Height="4"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                </Grid>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="设备名称：" />
                    <Run Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="设备型号：" />
                    <Run Text="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="处理器：" />
                    <Run Text="{x:Bind ViewModel.ProcessorDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="内存：" />
                    <Run Text="{x:Bind ViewModel.MemoryDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="操作系统：" />
                    <Run Text="{x:Bind ViewModel.OsDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontWeight="SemiBold" Text="硬盘信息：" />
                <TextBlock
                    Text="{x:Bind ViewModel.DiskInfoDisplay, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock FontWeight="SemiBold" Text="显卡信息：" />
                <TextBlock
                    Text="{x:Bind ViewModel.GpuInfoDisplay, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="网络信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="IPv4 地址：" />
                        <Run Text="{x:Bind ViewModel.EgressIpv4, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="IPv6 地址：" />
                        <Run Text="{x:Bind ViewModel.EgressIpv6, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="自治域：" />
                        <Run Text="{x:Bind ViewModel.Asn, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="服务商：" />
                        <Run Text="{x:Bind ViewModel.Isp, Mode=OneWay}" />
                        <Run Text="　　" />
                        <Run FontWeight="SemiBold" Text="组织：" />
                        <Run Text="{x:Bind ViewModel.Organization, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="时区：" />
                        <Run Text="{x:Bind ViewModel.TimeZone, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="位置：" />
                        <Run Text="{x:Bind ViewModel.Location, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="网卡信息"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox
                Grid.Column="1"
                PlaceholderText="筛选名称 / MAC / IP…"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="2"
                MinWidth="120"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.KindFilterOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedKindFilter, Mode=TwoWay}"
                DisplayMemberPath="Label"
                ToolTipService.ToolTip="按网卡类型筛选：全部 / 物理 / 虚拟 / NDIS筛选器" />
            <StackPanel
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Content="启用"
                    Click="EnableAdapter_Click"
                    IsEnabled="{x:Bind ViewModel.CanEnableSelected, Mode=OneWay}"
                    ToolTipService.ToolTip="启用所选网卡（物理 / 软网卡；需管理员权限）" />
                <Button
                    Content="禁用"
                    Click="DisableAdapter_Click"
                    IsEnabled="{x:Bind ViewModel.CanDisableSelected, Mode=OneWay}"
                    ToolTipService.ToolTip="禁用所选网卡（物理 / 软网卡；需管理员权限）" />
                <Button
                    Content="删除"
                    Click="RemoveAdapter_Click"
                    IsEnabled="{x:Bind ViewModel.CanRemoveSelected, Mode=OneWay}"
                    ToolTipService.ToolTip="仅软网卡可删除（卸载设备；物理网卡不可用）" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="4"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView
                ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                SelectionMode="Single"
                Style="{StaticResource DevtoyTableListViewStyle}"
                BorderThickness="0"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                helpers:TableListChrome.ColumnLines="True">
                <!-- 表头放进 ListView.Header，与行同宽（含滚动条槽），避免错位 -->
                <ListView.Header>
                    <Grid
                        Padding="12,10"
                        ColumnSpacing="8"
                        Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource DevtoyTableGridLineBrush}"
                        BorderThickness="0,0,0,1"
                        helpers:TableListChrome.ColumnLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="连接名" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="网卡名称" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="连接方式" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="速率" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="IPv4 信息" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="IPv6 信息" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="网关" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="8" Text="MAC" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="9" Text="持续时间" FontWeight="SemiBold" />
                    </Grid>
                </ListView.Header>
                <!-- 外层页面滚动：禁用虚拟化，按内容撑开高度 -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                        <!-- 与表头 Padding 水平一致 -->
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalNicRow">
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Description}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind NetworkName}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind AdapterName}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind KindLabel}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind ConnectionDisplay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="4"
                                Text="{x:Bind SpeedDisplay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="5"
                                Text="{x:Bind Ipv4Info}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="6"
                                Text="{x:Bind Ipv6Info}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="7"
                                Text="{x:Bind Gateway}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="8"
                                Text="{x:Bind Mac}"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="9"
                                Text="{x:Bind Duration}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

            <TextBlock
                Grid.Row="5"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.8" />
        </Grid>
    </ScrollViewer>
</Page>
