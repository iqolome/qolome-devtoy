<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Qolome.Nets.Core.Data"
    xmlns:local="using:Qolome.Nets.App"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    xmlns:helpers="using:Qolome_Devtoy_App.Helpers">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设备列表" Style="{StaticResource SubtitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    Header="网络环境"
                    MinWidth="160"
                    ItemsSource="{x:Bind ViewModel.Environments}"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}" />
                <ComboBox
                    Header="分组筛选"
                    MinWidth="140"
                    ItemsSource="{x:Bind ViewModel.GroupFilters}"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind ViewModel.SelectedGroupFilter, Mode=TwoWay}" />
                <ComboBox
                    Header="分配到分组"
                    MinWidth="140"
                    ItemsSource="{x:Bind ViewModel.Groups}"
                    DisplayMemberPath="Name"
                    PlaceholderText="取消分组"
                    SelectedItem="{x:Bind ViewModel.AssignGroup, Mode=TwoWay}"
                    ToolTipService.ToolTip="将列表中选中的设备分到同一分组；不选分组则取消分组" />
                <TextBox
                    Header="主机名 / 编码"
                    MinWidth="200"
                    PlaceholderText="搜索主机名或编码"
                    Text="{x:Bind ViewModel.HostnameQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Header="MAC"
                    MinWidth="180"
                    PlaceholderText="搜索任一网卡 MAC"
                    Text="{x:Bind ViewModel.MacQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="Assign_Click"
                    Content="分配"
                    ToolTipService.ToolTip="将选中设备分到同一分组。Ctrl 点选、Shift 连选可多选；不选分组则取消分组" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Add_Click" Content="新增" />
                <Button
                    Click="Delete_Click"
                    Content="删除"
                    ToolTipService.ToolTip="删除选中设备。Ctrl 点选、Shift 连选可多选，也可按 Delete 键" />
                <Button Click="Template_Click" Content="下载模板" />
                <Button Click="Import_Click" Content="导入 Excel" />
                <Button Click="Export_Click" Content="导出 Excel" />
                <Button
                    Click="Refresh_Click"
                    Content="一键更新"
                    ToolTipService.ToolTip="按勾选项探测并回填当前列表中的设备；更新过程中再次点击可停止" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid MinWidth="{x:Bind vm:DeviceListLayout.Shared.TotalWidth, Mode=OneWay}">
                <ListView
                    x:Name="DevicesList"
                    ItemsSource="{x:Bind ViewModel.Devices}"
                    SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                    SelectionMode="Extended"
                    SelectionChanged="Devices_SelectionChanged"
                    DoubleTapped="Devices_DoubleTapped"
                    KeyDown="Devices_KeyDown"
                    Style="{StaticResource DevtoyTableListViewStyle}"
                    helpers:TableListChrome.ColumnLines="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.Header>
                <Grid
                    Padding="12,8"
                    ColumnSpacing="0"
                    Background="{ThemeResource DevtoyTableHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource DevtoyTableBorderBrush}"
                    BorderThickness="0,0,0,1"
                    helpers:TableListChrome.ColumnLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.CheckLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.IndexLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.CodeLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.TypeLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.HostnameLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.VendorLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.BrandLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.ModelLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.DescriptionLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.IpLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.MacLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.DomainsLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.OsLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.GroupLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.CreatedLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.UpdatedLength, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.ActionsLength, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="HeaderSelectAll"
                        MinWidth="0"
                        HorizontalAlignment="Center"
                        IsThreeState="True"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="全选 / 取消全选"
                        Checked="OnSelectAllChanged"
                        Unchecked="OnSelectAllChanged" />
                    <TextBlock Grid.Column="1" Text="序号" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="2">
                        <HyperlinkButton
                            Padding="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SortCode_Click"
                            ToolTipService.ToolTip="按编码排序">
                            <TextBlock Text="{x:Bind ViewModel.CodeSortHeader, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <local:ColumnResizeThumb
                            Tag="Code"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="3">
                        <TextBlock Text="类型" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Type"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="4">
                        <HyperlinkButton
                            Padding="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SortHostname_Click"
                            ToolTipService.ToolTip="按主机名排序">
                            <TextBlock Text="{x:Bind ViewModel.HostnameSortHeader, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <local:ColumnResizeThumb
                            Tag="Hostname"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="5">
                        <HyperlinkButton
                            Padding="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SortVendor_Click"
                            ToolTipService.ToolTip="按厂商排序">
                            <TextBlock Text="{x:Bind ViewModel.VendorSortHeader, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <local:ColumnResizeThumb
                            Tag="Vendor"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="6">
                        <HyperlinkButton
                            Padding="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SortBrand_Click"
                            ToolTipService.ToolTip="按品牌排序">
                            <TextBlock Text="{x:Bind ViewModel.BrandSortHeader, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <local:ColumnResizeThumb
                            Tag="Brand"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="7">
                        <TextBlock Text="型号" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Model"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="8">
                        <TextBlock Text="设备说明" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Description"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="9">
                        <HyperlinkButton
                            Padding="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="SortIp_Click"
                            ToolTipService.ToolTip="按 IP 排序">
                            <TextBlock Text="{x:Bind ViewModel.IpSortHeader, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <local:ColumnResizeThumb
                            Tag="Ip"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="10">
                        <TextBlock Text="MAC" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Mac"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="11">
                        <TextBlock Text="域名" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Domains"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="12">
                        <TextBlock Text="系统" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Os"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="13">
                        <TextBlock Text="分组" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Group"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="14">
                        <TextBlock Text="创建时间" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Created"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <Grid Grid.Column="15">
                        <TextBlock Text="修改时间" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:ColumnResizeThumb
                            Tag="Updated"
                            PointerPressed="ColumnSplitter_PointerPressed"
                            PointerMoved="ColumnSplitter_PointerMoved"
                            PointerReleased="ColumnSplitter_PointerReleased"
                            PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />
                    </Grid>
                    <TextBlock Grid.Column="16" Text="操作" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                            <Setter Property="Padding" Value="12,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="data:Device">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.CheckLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.IndexLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.CodeLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.TypeLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.HostnameLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.VendorLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.BrandLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.ModelLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.DescriptionLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.IpLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.MacLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.DomainsLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.OsLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.GroupLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.CreatedLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.UpdatedLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind vm:DeviceListLayout.Shared.ActionsLength, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Tag="{x:Bind}"
                                    Loaded="OnRowCheckLoaded"
                                    Checked="OnRowCheckChanged"
                                    Unchecked="OnRowCheckChanged" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind RowIndex}"
                                    Opacity="0.75"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Code}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Rectangle
                                        Width="4"
                                        Height="16"
                                        RadiusX="1"
                                        RadiusY="1"
                                        Fill="{x:Bind local:DeviceTypeColorXaml.BrushFromType(DeviceType), Mode=OneTime}" />
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Stretch="Uniform"
                                        Source="{x:Bind local:DeviceTypeIconXaml.FromType(DeviceType), Mode=OneTime}" />
                                    <TextBlock Text="{x:Bind TypeName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{x:Bind Hostname}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Vendor}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Brand}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Model}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="8"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                                <TextBlock
                                    Grid.Column="9"
                                    Text="{x:Bind IpsText}"
                                    TextWrapping="WrapWholeWords"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind NicsTooltip}" />
                                <TextBlock
                                    Grid.Column="10"
                                    Text="{x:Bind MacsText}"
                                    FontSize="12"
                                    TextWrapping="WrapWholeWords"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind NicsTooltip}" />
                                <TextBlock Grid.Column="11" Text="{x:Bind DomainsText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="12" Text="{x:Bind OsType}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="13" Text="{x:Bind GroupName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="14"
                                    Text="{x:Bind CreateTimeDisplay}"
                                    Style="{StaticResource DevtoyTableDateTimeTextStyle}" />
                                <TextBlock
                                    Grid.Column="15"
                                    Text="{x:Bind ModifyTimeDisplay}"
                                    Style="{StaticResource DevtoyTableDateTimeTextStyle}" />
                                <helpers:ActionButtonWrapPanel Grid.Column="16" MaxWidth="356" VerticalAlignment="Center">
                                    <Button
                                        Tag="{x:Bind}"
                                        Click="RowEdit_Click"
                                        Style="{StaticResource DevtoyRowActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Viewbox
                                                Width="{StaticResource DevtoyGlyphIconBox}"
                                                Height="{StaticResource DevtoyGlyphIconBox}"
                                                VerticalAlignment="Center">
                                                <SymbolIcon Symbol="Edit" />
                                            </Viewbox>
                                            <TextBlock Text="编辑" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Tag="{x:Bind}"
                                        Click="RowDelete_Click"
                                        Style="{StaticResource DevtoyRowActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Viewbox
                                                Width="{StaticResource DevtoyGlyphIconBox}"
                                                Height="{StaticResource DevtoyGlyphIconBox}"
                                                VerticalAlignment="Center">
                                                <SymbolIcon Symbol="Delete" />
                                            </Viewbox>
                                            <TextBlock Text="删除" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                        </StackPanel>
                                    </Button>
                                </helpers:ActionButtonWrapPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
    </Grid>
</Page>
