<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.EnvironmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Qolome.Nets.Core.Data">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="网络环境" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock Grid.Column="1" Text="设备分组（属于所选环境）" Style="{StaticResource SubtitleTextBlockStyle}" />

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                ItemsSource="{x:Bind ViewModel.Environments}"
                SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}"
                DisplayMemberPath="Name"
                Style="{StaticResource DevtoyTableListViewStyle}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Click="AddEnv_Click" Content="新增" />
                <Button Click="EditEnv_Click" Content="编辑" />
                <Button Click="DeleteEnv_Click" Content="删除" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="一台设备只能属于一个网络环境。分组用于在该环境内分类。" />
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Groups}"
                SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                DisplayMemberPath="Name"
                Style="{StaticResource DevtoyTableListViewStyle}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Click="AddGroup_Click" Content="新增分组" />
                <Button Click="EditGroup_Click" Content="编辑分组" />
                <Button Click="DeleteGroup_Click" Content="删除分组" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Margin="0,8,0,0" />
    </Grid>
</Page>
