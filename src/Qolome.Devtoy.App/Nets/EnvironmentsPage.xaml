<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.EnvironmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Qolome.Nets.Core.Data">

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 网络环境 -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="网络环境"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button
                    Grid.Column="1"
                    Click="AddEnv_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Add" />
                        </Viewbox>
                        <TextBlock Text="新增" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Environments}"
                SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}"
                Style="{StaticResource DevtoyTableListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:NetworkEnvironment">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind DefaultCidr}"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <Button
                                    Tag="{x:Bind}"
                                    Click="EditEnv_Click"
                                    Style="{StaticResource DevtoyRowActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Viewbox
                                            Width="{StaticResource DevtoyGlyphIconBox}"
                                            Height="{StaticResource DevtoyGlyphIconBox}"
                                            VerticalAlignment="Center">
                                            <SymbolIcon Symbol="Edit" />
                                        </Viewbox>
                                        <TextBlock Text="编辑" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Tag="{x:Bind}"
                                    Click="DeleteEnv_Click"
                                    Style="{StaticResource DevtoyRowActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Viewbox
                                            Width="{StaticResource DevtoyGlyphIconBox}"
                                            Height="{StaticResource DevtoyGlyphIconBox}"
                                            VerticalAlignment="Center">
                                            <SymbolIcon Symbol="Delete" />
                                        </Viewbox>
                                        <TextBlock Text="删除" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 设备分组 -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="设备分组（属于所选环境）"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button
                    Grid.Column="1"
                    Click="AddGroup_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox
                            Width="{StaticResource DevtoyGlyphIconBox}"
                            Height="{StaticResource DevtoyGlyphIconBox}"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="Add" />
                        </Viewbox>
                        <TextBlock Text="新增分组" Style="{StaticResource DevtoyGlyphTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock
                Grid.Row="1"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="一台设备只能属于一个网络环境。分组用于在该环境内分类。" />
            <ListView
                Grid.Row="2"
                ItemsSource="{x:Bind ViewModel.Groups}"
                SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                Style="{StaticResource DevtoyTableListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:DeviceGroup">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <Button
                                    Tag="{x:Bind}"
                                    Click="EditGroup_Click"
                                    Style="{StaticResource DevtoyRowActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Viewbox
                                            Width="{StaticResource DevtoyGlyphIconBox}"
                                            Height="{StaticResource DevtoyGlyphIconBox}"
                                            VerticalAlignment="Center">
                                            <SymbolIcon Symbol="Edit" />
                                        </Viewbox>
                                        <TextBlock Text="编辑" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Tag="{x:Bind}"
                                    Click="DeleteGroup_Click"
                                    Style="{StaticResource DevtoyRowActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Viewbox
                                            Width="{StaticResource DevtoyGlyphIconBox}"
                                            Height="{StaticResource DevtoyGlyphIconBox}"
                                            VerticalAlignment="Center">
                                            <SymbolIcon Symbol="Delete" />
                                        </Viewbox>
                                        <TextBlock Text="删除" Style="{StaticResource DevtoyGlyphTextStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            Margin="0,4,0,0" />
    </Grid>
</Page>
