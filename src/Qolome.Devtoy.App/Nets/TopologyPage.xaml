<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qolome.Nets.App.TopologyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Qolome.Nets.App"
    xmlns:vm="using:Qolome.Nets.App.ViewModels"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp">

    <Page.Resources>
        <Style x:Key="TopologyToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="16" ColumnSpacing="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="网络拓扑"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button
                Grid.Column="1"
                Padding="10,6"
                VerticalAlignment="Center"
                Click="CloudSync_Click"
                IsEnabled="{x:Bind ViewModel.CloudSyncEnabled, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.CloudSyncHint, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        MinWidth="16"
                        MinHeight="16"
                        IsActive="{x:Bind ViewModel.CloudSyncBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CloudBusyVisibility, Mode=OneWay}" />
                    <FontIcon
                        Glyph="{x:Bind ViewModel.CloudSyncGlyph, Mode=OneWay}"
                        FontSize="16"
                        Foreground="{x:Bind ViewModel.CloudSyncBrush, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CloudIconVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CloudSyncText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind ViewModel.CloudSyncBrush, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    Header="网络环境"
                    MinWidth="160"
                    ItemsSource="{x:Bind ViewModel.Environments}"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}" />
                <DropDownButton x:Name="AddIspButton" VerticalAlignment="Bottom" Content="添加互联网">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="AddIspCmccItem"
                                Tag="cmcc"
                                Text="中国移动"
                                Click="AddIspPreset_Click" />
                            <MenuFlyoutItem
                                x:Name="AddIspUnicomItem"
                                Tag="unicom"
                                Text="中国联通"
                                Click="AddIspPreset_Click" />
                            <MenuFlyoutItem
                                x:Name="AddIspTelecomItem"
                                Tag="telecom"
                                Text="中国电信"
                                Click="AddIspPreset_Click" />
                            <MenuFlyoutItem
                                x:Name="AddIspCustomItem"
                                Tag="custom"
                                Text="自定义"
                                Click="AddIspCustom_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    VerticalAlignment="Bottom"
                    Click="AddContainer_Click"
                    Content="添加容器"
                    ToolTipService.ToolTip="命名容器以收纳同类节点；内部连线不受影响，容器本身也可连线" />
                <Button
                    VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Save_Click"
                    Content="保存" />
                <Button VerticalAlignment="Bottom" Click="Export_Click" Content="导出图片" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="Undo_Click"
                    Content="撤销"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                    ToolTipService.ToolTip="Ctrl+Z 撤销上一步" />
                <ToggleButton
                    x:Name="ToggleGrid"
                    VerticalAlignment="Bottom"
                    Click="ToggleGrid_Click"
                    Content="网格"
                    ToolTipService.ToolTip="显示或隐藏对齐网格" />
                <ToggleButton
                    x:Name="ToggleSnap"
                    VerticalAlignment="Bottom"
                    Click="ToggleSnap_Click"
                    Content="吸附"
                    ToolTipService.ToolTip="节点对齐到网格" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="CenterView_Click"
                    Content="定位中心"
                    ToolTipService.ToolTip="将拓扑中心滚到视口中央" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="ArrangeVertical_Click"
                    Content="上下排列"
                    ToolTipService.ToolTip="按连接关系上下分级，并优化左右顺序以减少连线交叉" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="ArrangeHorizontal_Click"
                    Content="左右排列"
                    ToolTipService.ToolTip="按连接关系左右分级，并优化上下顺序以减少连线交叉" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Text="操作"
                    VerticalAlignment="Center"
                    Opacity="0.8" />
                <Border
                    Padding="2"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            x:Name="ToolMove"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="0"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="拖动节点调整位置">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE7C2;"
                                    FontSize="16"
                                    HorizontalAlignment="Center" />
                                <TextBlock Text="移动" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ToolEthernet"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="1"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="灰实线表示网线，依次点击两个节点">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Rectangle
                                    Width="22"
                                    Height="3"
                                    Fill="#6B7280"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <TextBlock Text="网线" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ToolFiber"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="2"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="黄实线表示光纤，依次点击两个节点">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Rectangle
                                    Width="22"
                                    Height="3"
                                    Fill="#EAB308"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <TextBlock Text="光纤" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ToolWireless"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="3"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="黑虚线表示无线，依次点击两个节点">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Grid Width="22" Height="14">
                                    <Line
                                        X1="0"
                                        Y1="7"
                                        X2="22"
                                        Y2="7"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeThickness="3"
                                        StrokeDashArray="3,2" />
                                </Grid>
                                <TextBlock Text="无线" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ToolBluetooth"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="4"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="蓝虚线表示蓝牙，依次点击两个节点">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Grid Width="22" Height="14">
                                    <Line
                                        X1="0"
                                        Y1="7"
                                        X2="22"
                                        Y2="7"
                                        Stroke="#2563EB"
                                        StrokeThickness="3"
                                        StrokeDashArray="3,2" />
                                </Grid>
                                <TextBlock Text="蓝牙" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ToolIptv"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="5"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="红实线表示 IPTV，依次点击两个节点">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Rectangle
                                    Width="22"
                                    Height="3"
                                    Fill="#DC2626"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <TextBlock Text="IPTV" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ToolCustom"
                            Style="{StaticResource TopologyToolButtonStyle}"
                            Tag="6"
                            Click="ToolButton_Click"
                            ToolTipService.ToolTip="自定义颜色、虚实线和批注后再连线">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Grid Width="22" Height="14">
                                    <Line
                                        X1="0"
                                        Y1="7"
                                        X2="22"
                                        Y2="7"
                                        Stroke="#7C3AED"
                                        StrokeThickness="3"
                                        StrokeDashArray="3,2" />
                                </Grid>
                                <TextBlock Text="自定义" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel
                x:Name="CustomStylePanel"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <TextBox
                    Header="自定义颜色"
                    MinWidth="120"
                    Text="{x:Bind ViewModel.CustomColorHex, Mode=TwoWay}"
                    PlaceholderText="#7C3AED" />
                <Button VerticalAlignment="Bottom" Click="PickColor_Click" Content="选色" />
                <CheckBox
                    VerticalAlignment="Bottom"
                    Content="虚线"
                    IsChecked="{x:Bind ViewModel.CustomDashed, Mode=TwoWay}" />
                <TextBox
                    Header="连线批注"
                    MinWidth="160"
                    Text="{x:Bind ViewModel.CustomLabel, Mode=TwoWay}"
                    PlaceholderText="可选，显示在线旁" />
            </StackPanel>
        </StackPanel>

        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,10,12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="4,0"
                        Click="SortIp_Click"
                        ToolTipService.ToolTip="按 IP 排序">
                        <TextBlock Text="{x:Bind ViewModel.IpSortHeader, Mode=OneWay}" FontSize="12" />
                    </HyperlinkButton>
                </Grid>
                <StackPanel Grid.Row="1" Margin="12,0,12,8" Spacing="6">
                    <TextBox
                        PlaceholderText="搜索 IP / MAC / 主机名 / 类型 / 说明"
                        Text="{x:Bind ViewModel.DeviceQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <ListView
                    x:Name="DeviceList"
                    Grid.Row="2"
                    CanDragItems="True"
                    CanReorderItems="False"
                    AllowDrop="False"
                    DoubleTapped="DeviceList_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.Devices}"
                    SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                    Style="{StaticResource DevtoyTableListViewStyle}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DevtoyTableListViewItemStyle}">
                            <Setter Property="CanDrag" Value="True" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TopologyDeviceItem">
                            <Grid ColumnSpacing="8" Padding="0,2" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    Stretch="Uniform"
                                    Source="{x:Bind Icon, Mode=OneTime}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        IsTextSelectionEnabled="False" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle}"
                                        FontSize="11"
                                        Opacity="0.7"
                                        IsTextSelectionEnabled="False" />
                                    <TextBlock
                                        Text="{x:Bind TypeLine}"
                                        FontSize="11"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis"
                                        IsTextSelectionEnabled="False" />
                                    <TextBlock
                                        Text="{x:Bind DescriptionLine}"
                                        FontSize="11"
                                        Opacity="0.65"
                                        TextTrimming="CharacterEllipsis"
                                        IsTextSelectionEnabled="False" />
                                    <TextBlock
                                        Text="{x:Bind PlaceHint}"
                                        FontSize="11"
                                        Opacity="0.55"
                                        IsTextSelectionEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ScrollViewer
                x:Name="BoardHost"
                ZoomMode="Enabled"
                MinZoomFactor="0.4"
                MaxZoomFactor="2"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                AllowDrop="True"
                DragOver="Board_DragOver"
                Drop="Board_Drop">
                <Canvas
                    x:Name="Board"
                    Width="2400"
                    Height="1600"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    AllowDrop="True"
                    DragOver="Board_DragOver"
                    Drop="Board_Drop"
                    PointerPressed="Board_PointerPressed"
                    PointerMoved="Board_PointerMoved"
                    PointerReleased="Board_PointerReleased"
                    PointerCanceled="Board_PointerReleased"
                    PointerCaptureLost="Board_PointerReleased" />
            </ScrollViewer>
        </Border>

        <TextBlock
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
